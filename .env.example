SERV_API_KEY=          # console.openserv.ai/settings/keys
REPPO_API_KEY=         # eval.reppo.xyz/api-key (shown once)
DOLPHIN_API_KEY=       # optional until the coupon arrives; SERV reads bids meanwhile
BUYER_PRIVATE_KEY=     # TESTNET ONLY, created by `npm run wallets`
SERV_MODEL=gpt-6-luna
DEMO_TOKEN=            # set on public deploys so strangers can't spend your credits

# Optional (defaults in brackets)
# APPROVERS=                 # comma-separated addresses allowed to sign releases and appeal decisions (needed to release held money)
# APPEAL_QUORUM=1            # distinct approver signatures needed to overturn a slash
# TRUSTED_BUYERS=            # other buyer addresses whose tenders count in reputation
# EXTERNAL_REPUTATION_CLIENTS= # ERC-8004 feedback writers whose slashes raise the bond
# NEW_ADDRESS_MIN_TXS=5      # fewer sent txs = new address, quoted a 2x bond
# STABLE_TOKEN=0x38129cf4CE5E183eFF248F42A7D345Bb1B47621A   # bond token on Kite testnet
# ESCROW_ADDRESS=            # override deployments/kite-testnet.json
# SUCCESS_FEE_BPS=200        # success fee to the treasury (2%)
# TENDER_FEE_BASE=0.2        # x402 tender fee: base
# TENDER_FEE_PER_BID=0.06    # x402 tender fee: per bid slot
# X402_ASSET=0x8E04D099b1a8Dd20E6caD4b2Ab2B405B98242ec9     # PYUSD on Kite testnet
# X402_FACILITATOR=https://facilitator.pieverse.io
# X402_BASE=                 # 1 = also offer USDC on Base (production Kite Passport)
# CHALLENGE_FEE=0.05         # Break Lelang attempt price
# INSPECT_FEE=0.05           # POST /api/inspect price
# CHALLENGE_BOUNTY=1         # bounty from the fee wallet when the pool is empty
# POOL_BOUNTY_CAP=1          # bounty cap paid from the escrow's bounty pool
# BOUNTY_PER_DAY=3
# TREASURY_PRIVATE_KEY=      # TESTNET ONLY; pays bounties from the pool (payBounty)
# REPPO_LESSONS=             # 1 = use the distilled Reppo writing rules (off: they did not help)
# OPENSERV_AGENT=            # 1 = run the OpenServ agent inside the server
# PORT=3000
# LELANG_STATE=data/state.json
# CHALLENGE_STATE=data/challenges.json
# X402_SEEN=data/x402-nonces.json

# Supplier agent / MCP server (src/mcp.js)
# SUPPLIER_PRIVATE_KEY=      # TESTNET ONLY, your own key
# LELANG_URL=https://lelang-6k05.onrender.com
# LELANG_BIDS=~/.lelang/bids.json   # where salts are saved
# LELANG_MAX_BOND=1          # never lock more than this
# PAYER_PRIVATE_KEY=         # pays inspect_text (0.05 over x402); also scripts/break-lelang.js
# LELANG_PAY_NETWORK=eip155:2368    # eip155:5042002 for Arc USDC
# LELANG_MAX_FEE=0.1         # never sign an x402 payment above this
