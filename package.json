{
  "name": "lelang",
  "version": "1.0.0",
  "description": "Sealed-bid procurement run by agents: SERV + Jev decide, Dolphin reads, Reppo audits, Kite settles",
  "main": "index.js",
  "scripts": {
    "test": "node scripts/selftest.js && node scripts/api-test.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "demo": "node --env-file-if-exists=.env scripts/demo.js",
    "probe": "node --env-file-if-exists=.env scripts/probe.js",
    "wallets": "node --env-file-if-exists=.env scripts/wallets.js",
    "snapshot": "node scripts/snapshot.js",
    "compile": "hardhat compile",
    "deploy:escrow": "hardhat compile && node --env-file=.env scripts/deploy-escrow.js",
    "test:escrow": "node --env-file=.env scripts/escrow-test.js",
    "redteam": "node --env-file=.env scripts/redteam.js",
    "ocds:validate": "node scripts/ocds-validate.js",
    "verify": "node scripts/verify-slash.js",
    "test:contracts": "hardhat test",
    "coverage": "hardhat coverage",
    "slither": "hardhat compile && slither . --hardhat-ignore-compile --hardhat-artifacts-directory hh-artifacts --filter-paths \"node_modules|contracts/test\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "openai": "^7.55.0",
    "viem": "^2.57.18"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.1.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "hardhat": "^2.29.2",
    "solc": "^0.8.28"
  }
}
